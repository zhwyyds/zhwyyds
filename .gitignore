.DS_Store
__pycache__/
*.py[cod]
.Python
.venv/
venv/
.env
*.egg-info/
.dist/
.pytest_cache/
.mypy_cache/
.idea/
.vscode/
*.log
.cache/
config/secrets.json

# ── WorkBuddy 工作区记忆（非项目代码） ──
.workbuddy/

# ── 运行时生成产物 ──
# 评分明细（每指标 JSON + 汇总 CSV，由评分引擎生成）
scores/
# 发布记录（由发布动作生成）
releases/
# 评分验收报告（生成物，保留目录占位）
scoring/*.md
# 批量导入任务文件（H31：CSV 上传切分后生成的待办任务 JSON，运行时产物）
tasks/

# ── 覆盖率报告 ──
.coverage
.coverage.*
htmlcov/

# ── 工具缓存（额外兜底） ──
.ruff_cache/

# ── 本地备份（备份脚本产物，不入库） ──
backup/

# 文件锁残留
*.lock
