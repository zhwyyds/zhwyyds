# ── 数据治理平台环境变量 ──────────────────────────────────

# 项目根目录（不设则自动探测）
# DATA_GOV_BASE_DIR=/path/to/data_go

# CORS 允许的源（逗号分隔，不设则默认本地开发端口）
# DATA_GOV_CORS_ORIGINS=https://gov.example.com,https://staging.gov.example.com

# API Key 认证（不设则不启用认证，开发模式）
# DATA_GOV_API_KEY=your-secret-api-key

# LLM 模式：mock / live
# DATA_GOV_LLM_MODE=mock

# OpenAI
# OPENAI_API_KEY=sk-xxx

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-xxx

# 通义千问
# DASHSCOPE_API_KEY=sk-xxx

# 智谱AI
# ZHIPUAI_API_KEY=xxx

# DeepSeek（OpenAI 兼容，2026-08-05 新增）
# DEEPSEEK_API_KEY=sk-xxx
